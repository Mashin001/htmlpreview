      margin: 40px;
    }

    h2 {
      margin-top: 40px;
      font-size: 20px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    td {
      border: 1px solid #e0e0e0;
      padding: 12px;
      background-color: #f9f9f9;
    }

    td:first-child {
      width: 35%;
      font-weight: bold;
      background-color: #f1f1f1;
    }

    tr + tr td {
      border-top: none;
    }
  </style>
</head>
